<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:fa="clr-namespace:UraniumUI.Icons.FontAwesome;assembly=UraniumUI.Icons.FontAwesome"
             x:Class="AppSkeleton.CAppShell">
    <Grid RowDefinitions="auto, *, auto">
        <BoxView Grid.RowSpan="3"/>
        
        <Grid x:Name="TopBar" HeightRequest="50" ColumnDefinitions="auto, *, auto">
            <BoxView Grid.ColumnSpan="3" Color="{DynamicResource Primary}"/>

            <Grid>
                <ImageButton Padding="4" Margin="8" CornerRadius="8" Clicked="SideNavClicked">
                    <ImageButton.Source>
                        <FontImageSource FontFamily="FASolid" Glyph="{x:Static fa:Solid.Bars}"/>
                    </ImageButton.Source>
                </ImageButton>
                
            </Grid>

            <HorizontalStackLayout HorizontalOptions="Center" Grid.Column="1">
                <Image Margin="5,8" Source="logo.png"/>
                <Label x:Name="AppName" HorizontalOptions="Center" FontAttributes="Bold" VerticalOptions="Center" FontSize="20"></Label>
            </HorizontalStackLayout>

            <Grid Grid.Column="2">
                <ImageButton Padding="4" Margin="8, 0, 8,0" VerticalOptions="Center" CornerRadius="8" Clicked="ProfileMenuClicked">
                    <ImageButton.Source>
                        <FontImageSource FontFamily="FASolid" Glyph="{x:Static fa:Solid.User}"/>
                    </ImageButton.Source>
                </ImageButton>
            </Grid>
        </Grid>

        <Grid x:Name="ContentGrid" Grid.Row="1">
            <BoxView BackgroundColor="AliceBlue"/>
            <ContentView BackgroundColor="{DynamicResource White}" x:Name="Content"/>
        </Grid>

        <Grid x:Name="NavBar" Grid.Row="2" HeightRequest="55">
            <BoxView Color="{DynamicResource Primary}"/>
            <FlexLayout
                x:Name="NavBarFlexLayout"
                BindableLayout.ItemsSource="{Binding NavIconItems}"
                HorizontalOptions="Center"
                Direction="Row"
                JustifyContent="SpaceAround">

                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12" FlexLayout.Grow="1" FlexLayout.Basis="0%">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding LoadPageCommand}"  CommandParameter="{x:Reference Image}"/>
                            </Grid.GestureRecognizers>
                            <Image  x:Name="Image">
                                <Image.Source>
                                    <FontImageSource
                                        Color="{Binding Color}"  
                                        FontFamily="FASolid"
                                        Size="100"
                                        Glyph="{Binding Glyph}" />
                                </Image.Source>
                            </Image>
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

        </Grid>
        
        <Grid Grid.RowSpan="3" CascadeInputTransparent="False" InputTransparent="True" ColumnDefinitions="auto, *">
            <Grid x:Name="SideNav">
                <BoxView CornerRadius="0,8,0,8" BackgroundColor="{DynamicResource PrimaryDark}"/>
            </Grid>
            <Grid x:Name="CloseSideNavBar" IsVisible="False" Grid.Column="1">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="SideNavClicked"/>
                </Grid.GestureRecognizers>
            </Grid>
        </Grid>

        <Grid Grid.RowSpan="3" InputTransparent="True" CascadeInputTransparent="False" ColumnDefinitions="*, auto">
            <Grid x:Name="CloseProfileMenu" IsVisible="False" Grid.ColumnSpan="2">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="ProfileMenuClicked"/>
                </Grid.GestureRecognizers>
            </Grid>
            
            <Grid x:Name="ProfileMenu" Margin="10,60" Scale="0" IsVisible="False" VerticalOptions="Start" Grid.Column="1">
                <BoxView CornerRadius="8" BackgroundColor="{DynamicResource Primary}">
                    <BoxView.GestureRecognizers>
                        <TapGestureRecognizer></TapGestureRecognizer>
                    </BoxView.GestureRecognizers>
                </BoxView>

                
                <VerticalStackLayout Spacing="10" WidthRequest="100" Margin="10">

                    <Grid>
                        <BoxView CornerRadius="8" BackgroundColor="{DynamicResource PrimaryDark}"/>
                        <VerticalStackLayout Padding="5">
                            <Label HorizontalTextAlignment="Center" FontSize="16" Text="{Binding Username}" FontAttributes="Bold"/>

                            <HorizontalStackLayout Spacing="5" HorizontalOptions="Center">
                                <Image HeightRequest="15">
                                    <Image.Source>
                                        <FontImageSource FontFamily="FASolid" Size="100" Glyph="{x:Static fa:Solid.Coins}"/>
                                    </Image.Source>
                                </Image>
                                <Label Text="{Binding Coins}"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Grid>

                    <Button Text="Account" Clicked="AccountButtonClicked" Background="{DynamicResource PrimaryDark}" HeightRequest="30" Padding="0" MinimumHeightRequest="0" MinimumWidthRequest="0" TextColor="{DynamicResource White}"></Button>
                    <Button Text="Settings" Background="{DynamicResource PrimaryDark}" HeightRequest="30" Padding="0" MinimumHeightRequest="0" MinimumWidthRequest="0" TextColor="{DynamicResource White}"></Button>
                    <Button x:Name="GetPointsButton" Text="Get Points" Clicked="OnCreateRewardedAdClicked" Background="{DynamicResource PrimaryDark}" HeightRequest="30" Padding="0" MinimumHeightRequest="0" MinimumWidthRequest="0" TextColor="{DynamicResource White}"></Button>
                </VerticalStackLayout>
            </Grid>

        </Grid>

    </Grid>
</ContentPage>