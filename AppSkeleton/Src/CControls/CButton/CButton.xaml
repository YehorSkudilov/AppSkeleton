<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="AppSkeleton.CButton"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:AppSkeleton">

    <Grid x:Name="MainGrid" Loaded="MainGrid_Loaded">

        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped" />
        </Grid.GestureRecognizers>


        <local:AcrylicView
            BorderColor="{Binding CButtonStroke}"
            CornerRadius="{Binding CornerRadius}"
            EffectStyle="Custom"
            IsVisible="{Binding IsBackgroundVisible}"
            TintColor="{Binding CButtonBackgroundColor}"
            TintOpacity=".5" />

        <Grid VerticalOptions="Center" HorizontalOptions="Center">
            <Label Text="{Binding Text}"/>
            <Image
                Margin="{Binding IconPadding}"
                HeightRequest="{Binding IconHeightRequest}"
                MinimumHeightRequest="0"
                MinimumWidthRequest="0"
                WidthRequest="{Binding IconWidthRequest}">
                <Image.Source>
                    <FontImageSource
                        FontFamily="{Binding CurrentFontFamily}"
                        Glyph="{Binding Icon}"
                        Size="100" />
                </Image.Source>
            </Image>
        </Grid>
    </Grid>

</ContentView>