<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="AppSkeleton.CButton"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:AppSkeleton">

    <!--
        Only one of the two looks below is ever built (see BuildBackground in the code-behind) - both used to be
        built for every button with one hidden, which doubled every button's views (blur view included), most of
        them in list templates. The icon glyphs render at the size they're shown at, not at 100 and scaled down:
        each one was a bitmap many times bigger than what's on screen.
    -->
    <ContentView.Resources>
        <ResourceDictionary>
            <local:IsNotNullOrEmptyConverter x:Key="IsNotNullOrEmptyConverter" />

            <DataTemplate x:Key="AcrylicTemplate">
                <local:AcrylicView
                    x:Name="Background"
                    BorderColor="{Binding CButtonStroke}"
                    CornerRadius="{Binding CornerRadius}"
                    EffectStyle="Custom"
                    TintColor="{Binding CButtonBackgroundColor}"
                    TintOpacity=".5">

                    <Grid x:Name="ContentGrid">

                        <Grid
                            Padding="{Binding CButtonPadding}"
                            ColumnDefinitions="Auto,Auto"
                            ColumnSpacing="{Binding IconTextSpacing}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                            <Label
                                x:Name="TextLabel"
                                FontAttributes="{Binding FontAttributes}"
                                FontSize="{Binding FontSize}"
                                HorizontalOptions="Center"
                                IsVisible="{Binding Text, Converter={StaticResource IsNotNullOrEmptyConverter}}"
                                MinimumHeightRequest="0"
                                Text="{Binding Text}"
                                TextColor="{Binding TextColor}"
                                VerticalOptions="Center" />

                            <Grid
                                x:Name="IconStack"
                                HorizontalOptions="Center"
                                IsVisible="{Binding Icon, Converter={StaticResource IsNotNullOrEmptyConverter}}"
                                VerticalOptions="Center">
                                <Image
                                    HeightRequest="{Binding IconHeightRequest}"
                                    HorizontalOptions="Center"
                                    MinimumHeightRequest="0"
                                    MinimumWidthRequest="0"
                                    VerticalOptions="Center"
                                    WidthRequest="{Binding IconWidthRequest}">
                                    <Image.Source>
                                        <FontImageSource
                                            FontFamily="{Binding CurrentFontFamily}"
                                            Glyph="{Binding Icon}"
                                            Size="{Binding IconRenderSize}"
                                            Color="{Binding IconColor}" />
                                    </Image.Source>
                                </Image>
                            </Grid>
                        </Grid>
                    </Grid>

                </local:AcrylicView>
            </DataTemplate>

            <DataTemplate x:Key="FlatTemplate">
                <Border
                    x:Name="Background"
                    BackgroundColor="{Binding CButtonBackgroundColor}"
                    Stroke="{Binding CButtonStroke}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="{Binding CornerRadius}" />
                    </Border.StrokeShape>

                    <Grid x:Name="ContentGrid">
                        <HorizontalStackLayout
                            Padding="{Binding CButtonPadding}"
                            HorizontalOptions="Center"
                            Spacing="{Binding IconTextSpacing}"
                            VerticalOptions="Center">
                            <Label
                                x:Name="TextLabel"
                                FontAttributes="{Binding FontAttributes}"
                                FontSize="{Binding FontSize}"
                                HorizontalOptions="Center"
                                IsVisible="{Binding Text, Converter={StaticResource IsNotNullOrEmptyConverter}}"
                                MinimumHeightRequest="0"
                                Text="{Binding Text}"
                                TextColor="{Binding TextColor}"
                                VerticalOptions="Center" />

                            <Grid
                                x:Name="IconStack"
                                HorizontalOptions="Center"
                                IsVisible="{Binding Icon, Converter={StaticResource IsNotNullOrEmptyConverter}}"
                                VerticalOptions="Center">
                                <Image
                                    HeightRequest="{Binding IconHeightRequest}"
                                    HorizontalOptions="Center"
                                    MinimumHeightRequest="0"
                                    MinimumWidthRequest="0"
                                    VerticalOptions="Center"
                                    WidthRequest="{Binding IconWidthRequest}">
                                    <Image.Source>
                                        <FontImageSource
                                            FontFamily="{Binding CurrentFontFamily}"
                                            Glyph="{Binding Icon}"
                                            Size="{Binding IconRenderSize}"
                                            Color="{Binding IconColor}" />
                                    </Image.Source>
                                </Image>
                            </Grid>
                        </HorizontalStackLayout>
                    </Grid>
                </Border>
            </DataTemplate>

            <!--
                Avatar-style picture (e.g. a profile picture) instead of a font-icon glyph - only added (see
                UpdatePicture) once PictureSource is set, where it covers the glyph, being later in ContentGrid.
                Sits alongside the text/icon rather than inside it, so it fills the whole content area - IconHeight/
                WidthRequest only size the glyph. CButtonPadding is reused as its Margin so callers keep the same inset
                knob, rather than a full-bleed picture painting over the button's own border/background. Selection
                highlight for this case is the button's own CButtonStroke/thickness (see Select()).
            -->
            <DataTemplate x:Key="PictureTemplate">
                <Border
                    Margin="{Binding CButtonPadding}"
                    HorizontalOptions="Fill"
                    StrokeThickness="0"
                    VerticalOptions="Fill">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="999" />
                    </Border.StrokeShape>
                    <Image Aspect="AspectFill" Source="{Binding PictureSource}" />
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </ContentView.Resources>

    <Grid x:Name="MainGrid" Loaded="MainGrid_Loaded">

        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped" />
        </Grid.GestureRecognizers>

    </Grid>

</ContentView>
