<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppSkeleton.CButton">
    <Grid VerticalOptions="Center" HorizontalOptions="Center" x:Name="MainGrid">
        <Border Stroke="#40ffffff" StrokeThickness="1" Background="#20ffffff">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="30"/>
            </Border.StrokeShape>
        </Border>

        <Image MinimumHeightRequest="0" MinimumWidthRequest="0" Margin="{Binding IconPadding}" HeightRequest="{Binding IconHeightRequest}" WidthRequest="{Binding IconWidthRequest}">
            <Image.Source>
                <FontImageSource FontFamily="{Binding IconFontFamily}" Glyph="{Binding Icon}"/>
            </Image.Source>
        </Image>
    </Grid>
</ContentView>
