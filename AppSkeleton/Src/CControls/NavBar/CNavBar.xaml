<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AppSkeleton"
xmlns:acrylic="clr-namespace:Xe.AcrylicView;assembly=Xe.AcrylicView"
             x:Class="AppSkeleton.CNavBar">

    <Grid Padding="-5,0" x:Name="MainGrid" Grid.Row="2" HorizontalOptions="Center">
        <!--<Border Stroke="#40ffffff" StrokeThickness="1" Background="#20ffffff">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="30"/>
            </Border.StrokeShape>
        </Border>-->

        <acrylic:AcrylicView
                EffectStyle="Custom"    
                TintColor="#20ffffff" 
            BorderColor="#40ffffff"
                TintOpacity=".5"  
                CornerRadius="30">


            <FlexLayout
                x:Name="NavBarFlexLayout"
                BindableLayout.ItemsSource="{Binding CNavIconItems}"
                HorizontalOptions="Center"
                Direction="Row"
                JustifyContent="SpaceAround">

                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="3">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference MainGrid}, Path=BindingContext.LoadPageCommand}" CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>
                            <Border StrokeThickness="0" Padding="10">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="30"/>
                                </Border.StrokeShape>
                                <Image WidthRequest="30" HeightRequest="30" x:Name="Image">
                                    <Image.Source>
                                        <FontImageSource
                                        Color="{Binding Color}"  
                                        FontFamily="{Binding FontFamily}"
                                        Glyph="{Binding Glyph}" />
                                    </Image.Source>
                                </Image>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>
        </acrylic:AcrylicView>

    </Grid>
</ContentView>
