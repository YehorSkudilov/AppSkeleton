<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="AppSkeleton.CNavBar"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:AppSkeleton">

    <Grid
        x:Name="MainGrid"
        Grid.Row="2"
        HorizontalOptions="Center">

        <local:AcrylicView
                EffectStyle="Custom"
                TintColor="#20ffffff"
            BorderColor="#40ffffff"
                TintOpacity=".5"
                CornerRadius="30">

        <FlexLayout
                x:Name="NavBarFlexLayout"
                BindableLayout.ItemsSource="{Binding CNavIconItems}"
                Direction="Row"
                HorizontalOptions="Center"
                JustifyContent="SpaceAround">

                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="3">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference MainGrid}, Path=BindingContext.LoadPageCommand}" CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>
                            <Border Padding="10" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="30" />
                                </Border.StrokeShape>
                                <Image
                                    x:Name="Image"
                                    HeightRequest="30"
                                    WidthRequest="30">
                                    <Image.Source>
                                        <FontImageSource
                                            FontFamily="{Binding FontFamily}"
                                            Glyph="{Binding Glyph}"
                                            Color="{Binding Color}" />
                                    </Image.Source>
                                </Image>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>

            </FlexLayout>

        </local:AcrylicView>
    </Grid>
</ContentView>
