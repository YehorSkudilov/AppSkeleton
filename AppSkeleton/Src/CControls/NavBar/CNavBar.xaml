<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="AppSkeleton.CNavBar"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:AppSkeleton">

    <Grid
        x:Name="MainGrid"
        Grid.Row="2"
        HorizontalOptions="Fill">

        <local:AcrylicView
                EffectStyle="Custom"
                TintColor="{Binding TintColor}"
                BorderColor="{Binding BorderColor}"
                TintOpacity="{Binding TintOpacity}"
                CornerRadius="{Binding CornerRadius}">

        <!-- AlignItems Center: left at Stretch, each item fills the bar's height with its icon and label at the top of it,
             leaving the gap all at the bottom (an item's own VerticalOptions doesn't count in a FlexLayout). -->
        <FlexLayout
                x:Name="NavBarFlexLayout"
                BindableLayout.ItemsSource="{Binding CNavIconItems}"
                AlignItems="Center"
                Direction="Row"
                HorizontalOptions="Fill"
                JustifyContent="SpaceAround">

                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                      
                        <!-- Sizes come from the item (CNavItem.IconSize, ItemWidth, ...); their defaults are the standard look. -->
                        <Grid
                            WidthRequest="{Binding ItemWidth}"
                            Padding="3"
                            RowDefinitions="Auto,Auto"
                            RowSpacing="1"
                            VerticalOptions="Center">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference MainGrid}, Path=BindingContext.SelectPageCommand}" CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>

                            <Grid HorizontalOptions="Center" VerticalOptions="Center">
                                <!-- Optional circle behind the icon, for a prominent item. -->
                                <Border
                                    BackgroundColor="{Binding CurrentIconBackground}"
                                    HeightRequest="{Binding IconBackgroundSize}"
                                    IsVisible="{Binding HasIconBackground}"
                                    StrokeShape="RoundRectangle 999"
                                    StrokeThickness="0"
                                    WidthRequest="{Binding IconBackgroundSize}" />
                                <Image
                                    x:Name="Image"
                                    HeightRequest="{Binding IconSize}"
                                    WidthRequest="{Binding IconSize}"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center">
                                    <!-- Drawn large and scaled down to IconSize, as in CButton: left at its default size,
                                         Windows draws the glyph as a small bitmap and scales it up, blurry. -->
                                    <Image.Source>
                                        <FontImageSource
                                            FontFamily="{Binding FontFamily}"
                                            Glyph="{Binding CurrentGlyph}"
                                            Size="100"
                                            Color="{Binding CurrentColor}" />
                                    </Image.Source>
                                </Image>
                            </Grid>
                            <Label
                                Grid.Row="1"
                                FontSize="8"
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"
                                IsVisible="{Binding ShowLabel}"
                                LineBreakMode="NoWrap"
                                Text="{Binding PageName}"
                                TextColor="{Binding Source={x:Reference MainGrid}, Path=BindingContext.LabelColor}"
                                VerticalOptions="Start" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>

            </FlexLayout>

        </local:AcrylicView>
    </Grid>
</ContentView>
