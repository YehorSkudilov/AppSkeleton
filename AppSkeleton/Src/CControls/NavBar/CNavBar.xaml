<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="AppSkeleton.CNavBar"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:AppSkeleton">

    <Grid
        x:Name="MainGrid"
        Grid.Row="2"
        HorizontalOptions="Fill">

        <local:AcrylicView
                EffectStyle="Custom"
                TintColor="{Binding TintColor}"
                BorderColor="{Binding BorderColor}"
                TintOpacity="{Binding TintOpacity}"
                CornerRadius="{Binding CornerRadius}">

        <FlexLayout
                x:Name="NavBarFlexLayout"
                BindableLayout.ItemsSource="{Binding CNavIconItems}"
                Direction="Row"
                HorizontalOptions="Fill"
                JustifyContent="SpaceAround">

                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                      
                        <Grid
                            WidthRequest="64"
                            Padding="3"
                            RowDefinitions="Auto,Auto"
                            RowSpacing="1"
                            VerticalOptions="Center">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference MainGrid}, Path=BindingContext.SelectPageCommand}" CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>
          
                                <Image
                                    x:Name="Image"
                                    HeightRequest="24"
                                    WidthRequest="24"
                                    HorizontalOptions="Center">
                                    <Image.Source>
                                        <FontImageSource
                                            FontFamily="{Binding FontFamily}"
                                            Glyph="{Binding Glyph}"
                                            Color="{Binding Color}" />
                                    </Image.Source>
                                </Image>
                            <Label
                                Grid.Row="1"
                                FontSize="8"
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="NoWrap"
                                Text="{Binding PageName}"
                                TextColor="{Binding Source={x:Reference MainGrid}, Path=BindingContext.LabelColor}"
                                VerticalOptions="Start" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>

            </FlexLayout>

        </local:AcrylicView>
    </Grid>
</ContentView>
