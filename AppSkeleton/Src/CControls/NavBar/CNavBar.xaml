<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="AppSkeleton.CNavBar"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:AppSkeleton">

    <Grid
        x:Name="MainGrid"
        Grid.Row="2"
        HorizontalOptions="Center">

        <local:AcrylicView
                EffectStyle="Custom"
                TintColor="#20ffffff"
            BorderColor="#40ffffff"
                TintOpacity=".5"
                CornerRadius="30">

        <FlexLayout
                x:Name="NavBarFlexLayout"
                BindableLayout.ItemsSource="{Binding CNavIconItems}"
                Direction="Row"
                HorizontalOptions="Center"
                JustifyContent="SpaceAround">

                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <!--
                            HeightRequest/WidthRequest on this Grid are what actually
                            keep every item's slot (and so the spacing between icons)
                            identical regardless of label length - FlexLayout measures
                            this Grid at that fixed size. The Label below is NOT nested
                            inside the Border (MAUI's Border clips content to its rounded
                            shape) and has no width constraint of its own, so a long name
                            like "Transactions" renders in full and can visually overflow
                            past this slot's edge without being clipped or truncated,
                            and without pushing neighboring items - Grid doesn't clip
                            children to their cell bounds.
                        -->
                        <Grid
                            WidthRequest="64"
                            Padding="3"
                            RowDefinitions="Auto,Auto"
                            RowSpacing="1"
                            VerticalOptions="Center">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference MainGrid}, Path=BindingContext.SelectPageCommand}" CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>
          
                                <Image
                                    x:Name="Image"
                                    HeightRequest="24"
                                    WidthRequest="24"
                                    HorizontalOptions="Center">
                                    <Image.Source>
                                        <FontImageSource
                                            FontFamily="{Binding FontFamily}"
                                            Glyph="{Binding Glyph}"
                                            Color="{Binding Color}" />
                                    </Image.Source>
                                </Image>
                            <Label
                                Grid.Row="1"
                                FontSize="8"
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="NoWrap"
                                Text="{Binding PageName}"
                                TextColor="White"
                                VerticalOptions="Start" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>

            </FlexLayout>

        </local:AcrylicView>
    </Grid>
</ContentView>
