<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AppSkeleton.CFilterModalPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:AppSkeleton"
    BackgroundColor="Transparent">

    <Grid>

        <!--
            No dimmed backdrop - this behaves like a dropdown. Tapping anywhere
            outside the card still closes it, via this invisible full-page layer.
        -->
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnBackgroundTapped" />
        </Grid.GestureRecognizers>

        <!--
            CARD - anchored top-right like a dropdown from a header filter icon.
            AcrylicView defaults to VerticalOptions="Fill" (inherited from ContentView),
            which its custom Android measurement (BorderViewGroup.OnMeasure) turns into
            "claim the full height offered by the parent" whenever it gets an Exactly
            measure spec - Fill triggers exactly that. Explicitly non-Fill options here
            make it size to its actual content instead, same as every other AcrylicView
            usage in the app (which all put real content directly inside it, never as a
            content-less background sibling).
        -->
        <local:AcrylicView
            x:Name="CardAcrylic"
            Margin="16,70,16,0"
            Padding="16"
            BorderColor="#40ffffff"
            CornerRadius="25"
            EffectStyle="Custom"
            HorizontalOptions="End"
            TintColor="#20ffffff"
            TintOpacity=".5"
            VerticalOptions="Start"
            WidthRequest="280">

            <!--  Swallow taps so tapping the card itself doesn't fall through to the backdrop  -->
            <local:AcrylicView.GestureRecognizers>
                <TapGestureRecognizer />
            </local:AcrylicView.GestureRecognizers>

            <VerticalStackLayout Spacing="15">

                <Grid ColumnDefinitions="*,auto, *">
                    <Label
                        Grid.Column="1"
                        x:Name="TitleLabel"
                        FontAttributes="Bold"
                        FontSize="16"
                        TextColor="White"
                        VerticalOptions="Center" />

                    <local:CButton
                        Grid.Column="2"
                        HorizontalOptions="End"
                        CButtonBackgroundColor="Transparent"
                        CButtonStroke="Transparent"
                        Clicked="OnCloseClicked"
                        HeightRequest="24"
                        Icon="close"
                        IconFontFamily="OutlinedIcons"
                        IconHeightRequest="20"
                        UseAcrylicBackground="False"
                        WidthRequest="24" />
                </Grid>

                <BoxView Background="White" HeightRequest="1" Opacity="0.3" />

                <!--  CONTENT SLOT - the consumer's FilterContent gets attached here  -->
                <ContentView x:Name="ContentHost" />

                <Button
                    BackgroundColor="#30ffffff"
                    Clicked="OnResetClicked"
                    Text="Reset"
                    TextColor="White" />

                <Button
                    BackgroundColor="#4cd0f2"
                    Clicked="OnApplyClicked"
                    Text="Apply"
                    TextColor="Black" />

            </VerticalStackLayout>
        </local:AcrylicView>

    </Grid>

</ContentPage>
