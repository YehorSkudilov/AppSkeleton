<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AppSkeleton.CFilterModalPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:AppSkeleton"
    x:Name="Root"
    BackgroundColor="Transparent">

    <Grid TranslationX="5" TranslationY="-17.5">

        <!--
            No dimmed backdrop - this behaves like a dropdown. Tapping anywhere
            outside the card still closes it, via this invisible full-page layer.
        -->
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnBackgroundTapped" />
        </Grid.GestureRecognizers>

        <local:AcrylicView
            x:Name="CardAcrylic"
            Margin="16,70,16,0"
            Padding="10"
            BorderColor="#40ffffff"
            CornerRadius="25"
            EffectStyle="Custom"
            HorizontalOptions="End"
            MaximumHeightRequest="400"
            TintColor="#20ffffff"
            TintOpacity=".5"
            VerticalOptions="Start">

            <!--  Swallow taps so tapping the card itself doesn't fall through to the backdrop  -->
            <local:AcrylicView.GestureRecognizers>
                <TapGestureRecognizer />
            </local:AcrylicView.GestureRecognizers>


            <Grid RowDefinitions="auto,auto,*,auto,auto">

                <Grid ColumnDefinitions="*,auto, *">
                    <Label
                        x:Name="TitleLabel"
                        Grid.Column="1"
                        FontAttributes="Bold"
                        FontSize="16"
                        TextColor="White"
                        VerticalOptions="Center" />

                    <local:CButton
                        Grid.Column="2"
                        Margin="3,0"
                        CButtonBackgroundColor="Transparent"
                        CButtonStroke="Transparent"
                        Clicked="OnCloseClicked"
                        HeightRequest="24"
                        HorizontalOptions="End"
                        Icon="{Binding Icon, Source={x:Reference Root}}"
                        IconFontFamily="{Binding IconFontFamily, Source={x:Reference Root}}"
                        IconHeightRequest="18"
                        VerticalOptions="Center"
                        WidthRequest="24" />
                </Grid>

                <BoxView
                    Grid.Row="1"
                    Margin="0,10,0,0"
                    Background="White"
                    HeightRequest="1"
                    Opacity="0.3" />

                <!--  CONTENT SLOT - the consumer's FilterContent gets attached here  -->
                <ScrollView Grid.Row="2">
                    <ContentView x:Name="ContentHost" Margin="0,20" />
                </ScrollView>

                <BoxView
                    Grid.Row="3"
                    Margin="0,0,0,10"
                    Background="White"
                    HeightRequest="1"
                    Opacity="0.3" />

                <Grid
                    Grid.Row="4"
                    ColumnDefinitions="*,*"
                    ColumnSpacing="10"
                    HeightRequest="45">
                    
                    <local:CButton Clicked="OnResetClicked" Text="Reset" />

                    <local:CButton
                        Grid.Column="1"
                        Clicked="OnApplyClicked"
                        Text="Apply" />
                </Grid>
            </Grid>
        </local:AcrylicView>

    </Grid>

</ContentPage>
