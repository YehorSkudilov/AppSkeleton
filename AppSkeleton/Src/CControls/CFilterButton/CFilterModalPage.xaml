<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AppSkeleton.CFilterModalPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:AppSkeleton"
    BackgroundColor="Transparent">

    <Grid>

        <!--  No dimmed backdrop - this behaves like a dropdown. Tapping anywhere
              outside the card still closes it, via this invisible full-page layer.  -->
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnBackgroundTapped" />
        </Grid.GestureRecognizers>

        <!--  CARD - anchored top-right like a dropdown from a header filter icon  -->
        <local:AcrylicView
            Margin="16,70,16,0"
            Padding="16"
            BorderColor="#40ffffff"
            CornerRadius="25"
            EffectStyle="Custom"
            HorizontalOptions="End"
            TintColor="#20ffffff"
            TintOpacity=".5"
            VerticalOptions="Start"
            WidthRequest="280">

            <!--  Swallow taps so tapping the card itself doesn't fall through to the backdrop  -->
            <local:AcrylicView.GestureRecognizers>
                <TapGestureRecognizer />
            </local:AcrylicView.GestureRecognizers>

            <VerticalStackLayout Spacing="15">

                <Label
                    x:Name="TitleLabel"
                    FontAttributes="Bold"
                    FontSize="16"
                    HorizontalOptions="Center"
                    TextColor="White" />

                <BoxView Background="White" HeightRequest="1" Opacity="0.3" />

                <!--  CONTENT SLOT - the consumer's FilterContent gets attached here  -->
                <ContentView x:Name="ContentHost" />

                <Button
                    BackgroundColor="#30ffffff"
                    Clicked="OnResetClicked"
                    Text="Reset"
                    TextColor="White" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button
                        BackgroundColor="#30ffffff"
                        Clicked="OnCancelClicked"
                        Text="Cancel"
                        TextColor="White" />

                    <Button
                        Grid.Column="1"
                        BackgroundColor="#4cd0f2"
                        Clicked="OnApplyClicked"
                        Text="Apply"
                        TextColor="Black" />
                </Grid>

            </VerticalStackLayout>
        </local:AcrylicView>

    </Grid>

</ContentPage>
