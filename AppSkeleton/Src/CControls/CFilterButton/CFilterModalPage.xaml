<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AppSkeleton.CFilterModalPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#B0000000">

    <Grid>

        <!--  BACKDROP - tapping outside the card cancels  -->
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnBackgroundTapped" />
        </Grid.GestureRecognizers>

        <!--  CARD  -->
        <Border
            Margin="30"
            Padding="20"
            BackgroundColor="#1e1e1e"
            HorizontalOptions="Fill"
            Stroke="#40ffffff"
            VerticalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20" />
            </Border.StrokeShape>

            <!--  Swallow taps so tapping the card itself doesn't fall through to the backdrop  -->
            <Border.GestureRecognizers>
                <TapGestureRecognizer />
            </Border.GestureRecognizers>

            <VerticalStackLayout Spacing="15">

                <Label
                    x:Name="TitleLabel"
                    FontAttributes="Bold"
                    FontSize="18"
                    HorizontalOptions="Center"
                    TextColor="White" />

                <!--  CONTENT SLOT - the consumer's FilterContent gets attached here  -->
                <ContentView x:Name="ContentHost" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button
                        BackgroundColor="#30ffffff"
                        Clicked="OnCancelClicked"
                        Text="Cancel"
                        TextColor="White" />

                    <Button
                        Grid.Column="1"
                        BackgroundColor="#4cd0f2"
                        Clicked="OnApplyClicked"
                        Text="Apply"
                        TextColor="Black" />
                </Grid>

            </VerticalStackLayout>
        </Border>

    </Grid>

</ContentPage>
