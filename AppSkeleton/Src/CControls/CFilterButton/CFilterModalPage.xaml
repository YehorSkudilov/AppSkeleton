<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AppSkeleton.CFilterModalPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:AppSkeleton"
    BackgroundColor="Transparent">

    <Grid>

        <!--  No dimmed backdrop - this behaves like a dropdown. Tapping anywhere
              outside the card still closes it, via this invisible full-page layer.  -->
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnBackgroundTapped" />
        </Grid.GestureRecognizers>

        <!--  CARD - anchored top-right like a dropdown from a header filter icon.
              This outer Grid is sized by its content (the VerticalStackLayout below),
              not by the AcrylicView, which is why the acrylic is a same-cell background
              sibling rather than the sizing container - see BankListView for the same
              "Border/blur behind, real content in front, both in one auto-sized cell" trick.  -->
        <Grid
            x:Name="Card"
            Margin="16,70,16,0"
            HorizontalOptions="End"
            VerticalOptions="Start"
            WidthRequest="280">

            <local:AcrylicView
                BorderColor="#40ffffff"
                CornerRadius="25"
                EffectStyle="Custom"
                TintColor="#20ffffff"
                TintOpacity=".5" />

            <!--  Swallow taps so tapping the card itself doesn't fall through to the backdrop  -->
            <Grid.GestureRecognizers>
                <TapGestureRecognizer />
            </Grid.GestureRecognizers>

            <VerticalStackLayout Padding="16" Spacing="15">

                <Grid ColumnDefinitions="*,auto">
                    <Label
                        FontAttributes="Bold"
                        FontSize="16"
                        x:Name="TitleLabel"
                        TextColor="White"
                        VerticalOptions="Center" />

                    <local:CButton
                        Grid.Column="1"
                        Clicked="OnCloseClicked"
                        CButtonBackgroundColor="Transparent"
                        CButtonStroke="Transparent"
                        HeightRequest="24"
                        Icon="close"
                        IconFontFamily="OutlinedIcons"
                        IconHeightRequest="16"
                        IconWidthRequest="16"
                        WidthRequest="24" />
                </Grid>

                <BoxView Background="White" HeightRequest="1" Opacity="0.3" />

                <!--  CONTENT SLOT - the consumer's FilterContent gets attached here  -->
                <ContentView x:Name="ContentHost" />

                <Button
                    BackgroundColor="#30ffffff"
                    Clicked="OnResetClicked"
                    Text="Reset"
                    TextColor="White" />

                <Button
                    BackgroundColor="#4cd0f2"
                    Clicked="OnApplyClicked"
                    Text="Apply"
                    TextColor="Black" />

            </VerticalStackLayout>
        </Grid>

    </Grid>

</ContentPage>
