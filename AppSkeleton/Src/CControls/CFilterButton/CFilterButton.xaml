<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="AppSkeleton.CFilterButton"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:AppSkeleton"
    x:Name="Root"
    HorizontalOptions="Fill"
    VerticalOptions="Fill">

    <local:CButton
        Clicked="OnButtonClicked"
        HorizontalOptions="Fill"
        VerticalOptions="Fill"
        CButtonStroke="Transparent"
        CButtonBackgroundColor="Transparent"
        Icon="{Binding Icon, Source={x:Reference Root}}"
        IconFontFamily="{Binding IconFontFamily, Source={x:Reference Root}}"
        IconHeightRequest="{Binding IconHeightRequest, Source={x:Reference Root}}"
        IconWidthRequest="{Binding IconWidthRequest, Source={x:Reference Root}}" />

</ContentView>
