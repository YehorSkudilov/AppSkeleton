<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="AppSkeleton.CPasswordEntry"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid x:Name="MainGrid" ColumnDefinitions="*,Auto">
        <Entry
            x:Name="PasswordInput"
            Completed="OnEntryCompleted"
            IsPassword="True"
            Placeholder="{Binding Placeholder}"
            PlaceholderColor="{Binding PlaceholderColor}"
            ReturnType="{Binding ReturnType}"
            Text="{Binding Text, Mode=TwoWay}"
            TextColor="{Binding TextColor}" />

        <!--  Emoji, not an icon font glyph - no font asset dependency needed.  -->
        <Label
            x:Name="VisibilityToggle"
            Grid.Column="1"
            Margin="8,0,0,0"
            Text="👁"
            VerticalOptions="Center">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnToggleVisibility" />
            </Label.GestureRecognizers>
        </Label>
    </Grid>

</ContentView>
